# --- Google Cloud / BigQuery -------------------------------------------------
# Path to a service account JSON key with BigQuery read access to
# gdelt-bq.gdeltv2 (a public dataset -- a standard project with billing
# enabled is enough; no special access request is needed for the dataset
# itself, only for running queries against it).
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\vivgo\Downloads\dragons-data-etl-a0c915875082.json

# --- MongoDB ------------------------------------------------------------------
# Local example:
#   MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas example:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://rescatorade_db_user:eGsGRGuWf0q6ezsz@cluster0.dcdpzd4.mongodb.net
MONGODB_DATABASE=dragons_data_etl
